# Docker Compose settings. Copy to .env (never commit it).
# Database credentials are separate from every till/back-office login. Make each password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_NAME=pos
DB_OWNER_USER=pos_owner
DB_OWNER_PASSWORD=
DB_APP_USER=pos_app
DB_APP_PASSWORD=
# Address the database port listens on. 127.0.0.1 = this machine only; use the server's
# admin-network IP (e.g. 10.20.0.5) to let database administrators connect from that network.
DB_ADMIN_BIND=127.0.0.1
