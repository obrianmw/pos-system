DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset to use SQLite for local development.
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5180
DEFAULT_CURRENCY=MWK
PUBLIC_BASE_URL=http://localhost:8100

# The database admin site (/admin/) only answers on these networks (comma-separated), e.g. add 10.20.0.0/24.
ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
# 1 if Django sits behind one reverse proxy (nginx) that sets X-Forwarded-For; otherwise 0.
TRUSTED_PROXY_COUNT=0

# Payment providers (sandbox credentials). Per-branch overrides live in PaymentMethod.config.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=MW
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENV=sandbox
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_SECRET_KEY=
